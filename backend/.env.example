# Gemini (optional - only used if you want to swap providers back)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (primary LLM provider - free tier at console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interview_coach

# Session cookie signing - generate a real random value for anything beyond local dev
# e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-in-production

# Google OAuth (create these in Google Cloud Console - see README checklist)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: wire up Sentry later by setting this - no-op if unset
SENTRY_DSN=
